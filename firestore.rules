rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isPolice() {
      return isAuthenticated() && request.auth.token.police == true;
    }

    // 1. Users collection
    // Users can read and write only their own profile document
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isPolice();
    }

    // 2. Alerts collection
    // Citizens create their own alerts; contacts named in the alert or police can read;
    // only police (or the owning user for cancellation) can update status.
    match /alerts/{alertId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        isPolice() ||
        request.auth.uid in resource.data.contactUids
      );
      allow update: if isPolice() || (
        resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'cancelled'
      );
      allow delete: if false;

      // Live location subcollection
      match /liveLocation/{pointId} {
        allow create, write: if isAuthenticated() && (
          get(/databases/$(database)/documents/alerts/$(alertId)).data.uid == request.auth.uid
        );
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/alerts/$(alertId)).data.uid == request.auth.uid ||
          isPolice() ||
          request.auth.uid in get(/databases/$(database)/documents/alerts/$(alertId)).data.contactUids
        );
      }
    }

    // 3. Incidents collection (Crowdsourced + Police records)
    // Citizens have write-only permission to submit anonymous reports.
    // Heatmap aggregations and police can read.
    match /incidents/{incidentId} {
      allow create: if true; // Anonymous citizens can report incidents
      allow read: if true;   // Aggregated for public safety heat map
      allow update, delete: if isPolice();
    }

    // 4. Zones published (Police control)
    // Public can read; only users with custom claim 'police' can modify.
    match /zonesPublished/{cellId} {
      allow read: if true;
      allow write: if isPolice();
    }
  }
}
